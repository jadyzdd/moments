  },
  {
    "id": "album-b4-04",
    "author": {
      "name": "小明",
      "initial": "明"
    },
    "text": "美厨娘\n会工作\n会摄影\n会下厨\n会……你有什么是不会",
    "images": [
      "assets/uploads/20141129-b404.jpg"
    ],
    "location": "杭州 · 厨房",
    "likes": [],
    "likedByMe": false,
