    "id": "pdf2016-p12",
    "author": {
      "name": "小明",
      "initial": "明"
    },
    "text": "马尔代夫的阳光与浪花",
    "images": [
      "assets/uploads/pdf2016-p12.jpg"
    ],
    "location": "马尔代夫",
    "likes": [],
    "likedByMe": false,
    "comments": [],
    "createdAt": 1465891200000
